#!/usr/bin/env bash
# Creates the dsh profile that the plugin runs agents on (README, "The buzz
# profile").
#
# Why: Buzz has its own profile, so no other dsh profile needs the Buzz bundle
# or changes for it. The steps are the same on each computer. The bundle turns
# off the uploads that this profile must never make, and this script refuses a
# result where dsh does not show them off. dsh's own template command replaces
# a profile that exists, so this script refuses to run on one.
#
# Usage: scripts/setup-buzz-profile
#   DSH_HOME  dsh's home folder, as dsh reads it (default: ~/.dsh)
#
# It writes only inside that one new profile folder. It holds no key: dsh reads
# provider keys from the environment that the profile's patch names.
set -euo pipefail

readonly EX_CONFIG=78
readonly EX_FAILED=1
readonly PROFILE=buzz
# The dsh template with the ACP server, which the bundle needs.
readonly TEMPLATE=acp
readonly BUNDLE_DIR=dsh-acp-buzz
# Long agent sessions must condense before the provider's window ends. An exact
# version from npm, as this bundle lives in another repository: any computer
# can install it, and the profile's lockfile holds its integrity hash.
readonly AUTO_COMPACT_PACKAGE=@sagmans/dsh-auto-compact@0.2.1
readonly PATCH_ROWS=scripts/buzz-profile.patch.yml
readonly PROFILE_PATCH=cordis.patch.yml
readonly EMPTY_PATCH='[]'
# The row that exists only when the bundle loaded (dsh-acp-buzz/cordis.patch.yml).
readonly BUNDLE_ROW='id: acp-buzz'
# The row that the auto-compact bundle adds, and the patch key that sets its
# budget. The value lives only in PATCH_ROWS, so an owner changes it in one place.
readonly AUTO_COMPACT_ROW='id: auto-compact'
readonly AUTO_COMPACT_KEY='thresholdTokens:'
# Lines after AUTO_COMPACT_ROW that hold the budget in dsh's config dump.
readonly AUTO_COMPACT_DUMP_LINES=3
# How dsh's composed config shows each upload row of the bundle's patch off. dsh
# only warns about a patch row whose target is gone, so a renamed row in a new
# dsh must stop this script.
readonly UPLOAD_ROWS_OFF=(
	'session-log-deepseek:    enabled: false'
	'plugin-package-inventory-deepseek:    enabled: false'
	'session-telemetry-otel:  disabled: true'
)
readonly DSH_START_TIMEOUT_SECONDS=120
# `dsh plugin add` runs a package install for the profile.
readonly DSH_ADD_TIMEOUT_SECONDS=300

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source-path=SCRIPTDIR source=../.githooks/lib/tools.sh
. "$repo_root/.githooks/lib/tools.sh"

die() {
	echo "setup-buzz-profile: $2" >&2
	exit "$1"
}

dsh_home=${DSH_HOME:-$HOME/.dsh}
profile_dir="$dsh_home/profiles/$PROFILE"

command -v dsh >/dev/null || die "$EX_CONFIG" "dsh is not on PATH: install DeepSeek Harness first"
[ -d "$repo_root/$BUNDLE_DIR" ] || die "$EX_CONFIG" "no $BUNDLE_DIR folder in $repo_root"
[ -f "$repo_root/$PATCH_ROWS" ] || die "$EX_CONFIG" "no $PATCH_ROWS in $repo_root"
[ ! -e "$profile_dir" ] || die "$EX_CONFIG" "$profile_dir exists: this script never replaces a profile"

# True when the top-level row in the config on stdin holds the exact line.
row_has_setting() {
	awk -v row="- id: $1" -v setting="$2" '
		$0 == row { inside = 1; next }
		/^- / { inside = 0 }
		inside && $0 == setting { found = 1 }
		END { exit !found }
	'
}

# A failure after this point leaves a part-made profile. It stays for the
# owner to read: the message names it, and a new run refuses until it is gone.
failed() {
	die "$EX_FAILED" "$1. $profile_dir is not complete: read it, move it away, then run this again"
}

run_with_timeout "$DSH_START_TIMEOUT_SECONDS" dsh --from-default-profile "$TEMPLATE" --profile "$PROFILE" --help >/dev/null ||
	failed "dsh could not make the profile from its $TEMPLATE template"
[ -d "$profile_dir" ] || failed "dsh made no profile folder"
run_with_timeout "$DSH_ADD_TIMEOUT_SECONDS" dsh plugin --profile "$PROFILE" add "link:$repo_root/$BUNDLE_DIR" ||
	failed "dsh could not add the bundle"
# Exact, so that a later release reaches this profile only by a change here.
run_with_timeout "$DSH_ADD_TIMEOUT_SECONDS" dsh plugin --profile "$PROFILE" add --save-exact "$AUTO_COMPACT_PACKAGE" ||
	failed "dsh could not add $AUTO_COMPACT_PACKAGE"
# The template's patch is an empty YAML array, which rows cannot follow.
patch_file="$profile_dir/$PROFILE_PATCH"
patch_header=$(grep -vxF "$EMPTY_PATCH" -- "$patch_file") || failed "cannot read $PROFILE_PATCH"
{
	printf '%s\n\n' "$patch_header"
	cat -- "$repo_root/$PATCH_ROWS"
} >"$patch_file" || failed "cannot write $PROFILE_PATCH"
config_dump=$(run_with_timeout "$DSH_START_TIMEOUT_SECONDS" dsh --profile "$PROFILE" --dump-config) ||
	failed "dsh could not show the profile config"
grep -qF -- "$BUNDLE_ROW" <<<"$config_dump" ||
	failed "the profile config has no bundle row"
# The bundle's own default also has this key. Only the patch's exact line proves
# that the owner's budget is the one in effect.
budget_line=$(grep -F -- "$AUTO_COMPACT_KEY" "$repo_root/$PATCH_ROWS") ||
	failed "no $AUTO_COMPACT_KEY line in $PATCH_ROWS"
grep -A"$AUTO_COMPACT_DUMP_LINES" -F -- "$AUTO_COMPACT_ROW" <<<"$config_dump" | grep -qxF -- "$budget_line" ||
	failed "the profile config does not have the budget of $PATCH_ROWS"
for row_off in "${UPLOAD_ROWS_OFF[@]}"; do
	row_has_setting "${row_off%%:*}" "${row_off#*:}" <<<"$config_dump" ||
		failed "the profile config does not show ${row_off%%:*} off"
done

echo "made $profile_dir"
echo "Next: add your provider to $profile_dir/$PROFILE_PATCH, on the row '$BUNDLE_ROW' and the provider row."
